# Ascender (Podman native) configuration. Installed to /etc/ascender/ascender.conf
# by install.sh, which also fills in the secrets. KEY=VALUE lines only; quote
# values containing spaces. Read by /usr/libexec/ascender/manage-containers.sh.

# --- Images -----------------------------------------------------------------
ASCENDER_IMAGE=ghcr.io/ctrliq/ascender
ASCENDER_VERSION=latest
# Built locally from /usr/libexec/ascender/receptor when not present.
ASCENDER_RECEPTOR_IMAGE=ghcr.io/ctrliq/ascender-receptor
RECEPTOR_IMAGE=quay.io/ansible/receptor:v1.6.8
POSTGRES_IMAGE=quay.io/sclorg/postgresql-15-c9s
VALKEY_IMAGE=ghcr.io/valkey-io/valkey:9-alpine

# --- Access -----------------------------------------------------------------
# Name users reach the UI with (Host header allowlist, CSRF trusted origins,
# generated certificate). Requests with any other Host header get a 400.
ASCENDER_HOSTNAME=localhost
# Other names users reach the UI with, comma-separated (an IP address, an alias).
ASCENDER_ALLOWED_HOSTS=
ASCENDER_HTTP_PORT=80
ASCENDER_HTTPS_PORT=443
# redirect: plain http only redirects to https (default).
# insecure: serve the UI over plain http too; session/CSRF cookies lose the Secure flag.
ASCENDER_HTTP_MODE=redirect
# Instance name shown in the UI, also the pod hostname. Must be a valid hostname.
ASCENDER_NODE_NAME=ascender

# --- Admin user ---------------------------------------------------------------
ASCENDER_ADMIN_USER=admin
ASCENDER_ADMIN_PASSWORD=
ASCENDER_ADMIN_EMAIL=admin@example.com

# --- Database -----------------------------------------------------------------
# ENABLE_POSTGRES=true runs the bundled PostgreSQL container inside the pod
# (reached on the pod's loopback; ASCENDER_PGSQL_HOST is ignored). Set it to
# false and point ASCENDER_PGSQL_HOST at an external database to use your own.
ENABLE_POSTGRES=true
ASCENDER_PGSQL_HOST=
ASCENDER_PGSQL_PORT=5432
ASCENDER_PGSQL_DB=ascender
ASCENDER_PGSQL_USER=ascender
ASCENDER_PGSQL_PWD=
POSTGRES_MAX_CONNECTIONS=1024

# --- Secrets (generate with: openssl rand -base64 30) ---------------------------
# Django SECRET_KEY. Changing it after install makes stored credentials unreadable.
ASCENDER_SECRET_KEY=
# Shared secret between the web nodes and the task container's websocket relay.
ASCENDER_WEBSOCKET_SECRET=

# --- Paths (normally left alone) -----------------------------------------------
# Config files (settings.py, nginx*.conf, receptor.conf, valkey.conf, certs/).
#ASCENDER_CONFIG_DIR=/etc/ascender
# Scripts and the receptor image build context.
#ASCENDER_LIBEXEC_DIR=/usr/libexec/ascender
